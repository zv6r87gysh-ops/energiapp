# Fas 1 kräver inga miljövariabler eller externa konton.
# Fas 2 (ännu ej implementerad):
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Serverhemligheter får aldrig använda NEXT_PUBLIC_-prefix.

# Valfritt: false stänger av den publika prishämtningen. Aktiv som standard.
ELECTRICITY_PRICES_ENABLED=true

# Valfri molnmusik (Sonos Control API + Spotify Connect). Inga nycklar i NEXT_PUBLIC_.
# Båda tjänsternas utvecklarappar måste registreras för denna exakta adress.
MUSIC_PUBLIC_ORIGIN=https://energiapp-rho.vercel.app
# Generera en slumpmässig hemlighet, t.ex. openssl rand -hex 32
MUSIC_SESSION_SECRET=
SONOS_CLIENT_ID=
SONOS_CLIENT_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
